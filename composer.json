{
    "name": "nswdpc/silverstripe-search-boilerplate",
    "description": "Boilerplate configuration for extensible search",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "James Ellis",
            "role": "Developer"
        },
        {
            "name": "Mark Taylor",
            "role": "Developer"
        }
    ],
    "keywords": [
      "silverstripe",
      "search",
      "elastic",
      "elastica",
      "elasticsearch"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/JamesDPC/silverstripe-extensible-elastic.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/JamesDPC/silverstripe-extensible-search.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nswdpc/ci-files.git"
        }
    ],
    "require": {
        "heyday/silverstripe-elastica": "^4.3",
        "nglasl/silverstripe-extensible-search": "*",
        "nyeholt/silverstripe-extensible-elastic": "*",
        "nswdpc/silverstripe-elemental-extensible-search": "*",
        "symbiote/silverstripe-multivaluefield": "^6"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^1",
        "phpunit/phpunit": "^9.5",
        "cambis/silverstan": "^1",
        "nswdpc/ci-files": "dev-v-3"
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
